{
    "name": "micro-front-main-shell",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "test:watch": "ng test",
        "test:coverage": "ng test --watch=false --coverage",
        "test:ci": "ng test --watch=false --ci",
        "lint": "ng lint",
        "lint:fix": "ng lint --fix",
        "format": "prettier --check \"src/**/*.{ts,html,scss,json}\" \"*.{json,js,md}\"",
        "format:fix": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"*.{json,js,md}\""
    },
    "private": true,
    "dependencies": {
        "@angular-architects/module-federation": "^22.0.0",
        "@angular-architects/native-federation": "^22.1.2",
        "@angular/animations": "^22.1.6",
        "@angular/cdk": "^22.1.6",
        "@angular/common": "^22.1.6",
        "@angular/compiler": "^22.1.6",
        "@angular/core": "^22.1.6",
        "@angular/forms": "^22.1.6",
        "@angular/localize": "^22.1.6",
        "@angular/material": "^22.1.6",
        "@angular/platform-browser": "^22.1.6",
        "@angular/platform-browser-dynamic": "^22.1.6",
        "@angular/router": "^22.1.6",
        "@softarc/native-federation-node": "^3.5.6",
        "es-module-shims": "^2.8.4",
        "rxjs": "~7.8.0",
        "tslib": "^2.8.1",
        "zone.js": "~0.16.3"
    },
    "devDependencies": {
        "@angular-builders/jest": "^22.0.1",
        "@angular/build": "^22.1.8",
        "@angular/cli": "^22.1.8",
        "@angular/compiler-cli": "^22.1.6",
        "@eslint/js": "^10.0.1",
        "@types/jest": "^30.0.0",
        "angular-eslint": "22.5.0",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "jest": "^30.5.1",
        "jest-environment-jsdom": "^30.5.1",
        "jest-preset-angular": "^17.0.0",
        "prettier": "^3.9.6",
        "typescript": "~6.0.0",
        "typescript-eslint": "^8.70.0"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "@parcel/watcher@2.6.0": true,
        "lmdb@3.5.6": true,
        "msgpackr-extract@3.0.4": true
    }
}
